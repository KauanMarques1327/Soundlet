
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Soundlet.MainPage"
    BackgroundColor="#0B132B"
    NavigationPage.HasNavigationBar="False">

    <AbsoluteLayout>

        <!-- Imagem oficial do Soundlet -->
        <Image
            Source="soundlet_home.png"
            Aspect="AspectFill"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All" />

        <!-- Botão Bluetooth transparente -->
        <Button
            Text=""
            BackgroundColor="Transparent"
            BorderWidth="0"
            CornerRadius="40"
            Clicked="OnBluetoothClicked"
            SemanticProperties.Description="Conectar via Bluetooth"
            AbsoluteLayout.LayoutBounds="0.5,0.67,0.74,0.07"
            AbsoluteLayout.LayoutFlags="All" />

    </AbsoluteLayout>

</ContentPage>
