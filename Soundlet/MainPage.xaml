<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soundlet.MainPage" BackgroundColor="#0B132B" Shell.NavBarIsVisible="False">
    <AbsoluteLayout>
    <Grid SafeAreaEdges="None" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
        <Image Source="soundlet_home_background.png" Aspect="AspectFill" InputTransparent="True" />
        <AbsoluteLayout x:Name="ArtworkLayout" SafeAreaEdges="None"
                        IsClippedToBounds="True" SizeChanged="OnArtworkSizeChanged">
            <GraphicsView x:Name="ConnectionArtwork" InputTransparent="True"
                          AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" />
            <Button x:Name="BluetoothButton" Text="" BackgroundColor="Transparent"
                    BorderWidth="0" Padding="0" CornerRadius="40"
                    MinimumWidthRequest="0" MinimumHeightRequest="0"
                    AutomationId="BluetoothConnection" Clicked="OnBluetoothClicked" />
            <Button x:Name="WifiButton" Text="" BackgroundColor="Transparent"
                    BorderWidth="0" Padding="0" CornerRadius="40"
                    MinimumWidthRequest="0" MinimumHeightRequest="0"
                    AutomationId="WifiConnection" Clicked="OnWifiClicked" />
        </AbsoluteLayout>
    </Grid>
    </AbsoluteLayout>
</ContentPage>
