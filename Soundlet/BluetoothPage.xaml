

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Soundlet.BluetoothPage"
    BackgroundColor="#0B132B"
    Shell.NavBarIsVisible="False">

    

    <AbsoluteLayout>

        <!-- Imagem e arcos compartilham o mesmo viewport, já dentro da área segura. -->
        <Grid
            SafeAreaEdges="None"
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">

            <Image
                Source="soundlet_search.png"
                InputTransparent="True"
                Aspect="AspectFill" />

            <AbsoluteLayout
                x:Name="ArtworkLayout"
                SafeAreaEdges="None"
                IsClippedToBounds="True"
                SizeChanged="OnArtworkSizeChanged">

                <GraphicsView
                    x:Name="CentralLoading"
                    InputTransparent="True" />

                <GraphicsView
                    x:Name="SearchLoading"
                    InputTransparent="True" />

                <!-- Área de toque do botão amarelo da imagem. -->
                <Button
                    x:Name="BackButton"
                    Text=""
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    ZIndex="10"
                    SemanticProperties.Description="Voltar para a tela inicial"
                    Clicked="OnBackClicked" />

                <Border x:Name="DeviceCardMask" BackgroundColor="#00101F" Stroke="#145A83"
                        StrokeShape="RoundRectangle 24" Padding="8" ZIndex="11">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label x:Name="SearchStatus" Text="Procurando pulseira..." TextColor="#BCC2D3"
                               FontSize="13" HorizontalTextAlignment="Center" />
                        <Button x:Name="RetryButton" Text="Buscar novamente" IsVisible="False" FontSize="12"
                                Padding="0" MinimumHeightRequest="28" HeightRequest="28"
                                BackgroundColor="Transparent" TextColor="#00D8F4" Clicked="OnRetryClicked" />
                    </VerticalStackLayout>
                </Border>
                <Button
                    x:Name="DeviceCardButton"
                    IsEnabled="False"
                    Text=""
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    CornerRadius="24"
                    MinimumWidthRequest="0"
                    MinimumHeightRequest="0"
                    ZIndex="10"
                    SemanticProperties.Description="Soundlet Pulseira, ESP32-S3. Conectar por Bluetooth"
                    Clicked="OnPulseiraClicked" />

            </AbsoluteLayout>
        </Grid>

    </AbsoluteLayout>
</ContentPage>
