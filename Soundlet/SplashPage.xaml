<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Soundlet.SplashPage"
             BackgroundColor="#0B132B" SafeAreaEdges="None"
             Shell.NavBarIsVisible="False">
    <Grid x:Name="Composition" SafeAreaEdges="None">
        <!-- The artwork contains no baked-in progress track or fill. -->
        <Image Source="soundlet_splash.png" Aspect="AspectFill" InputTransparent="True" />
        <GraphicsView x:Name="PresentationBar" InputTransparent="True"
                      SemanticProperties.Description="Apresentação do Soundlet" />
    </Grid>
</ContentPage>
